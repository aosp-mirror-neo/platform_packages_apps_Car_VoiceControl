<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/preferences_title">

    <PreferenceCategory
        android:title="@string/general_preferences">

        <Preference
            android:key="sign_in_out"/>

        <SwitchPreference
            android:key="toggle_summary"
            android:title="@string/hotword_enabled_preference"
            android:summaryOn="@string/summary_on_toggle_preference"
            android:summaryOff="@string/summary_off_toggle_preference"/>

        <ListPreference
            android:key="voice"
            android:title="@string/preference_voice"
            android:summary="@string/preference_voice_summary"/>

        <SwitchPreference
                android:key="toggle_debug_direct_send"
                android:title="@string/debug_direct_send_preference"
                android:summaryOn="@string/summary_on_direct_send_preference"
                android:summaryOff="@string/summary_off_direct_send_preference"/>

    </PreferenceCategory>
</PreferenceScreen>